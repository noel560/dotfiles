! X colors.
! Generated by 'wal'
*foreground:        #c1c3c5
*background:        #0a1218
*.foreground:       #c1c3c5
*.background:       #0a1218
emacs*foreground:   #c1c3c5
emacs*background:   #0a1218
URxvt*foreground:   #c1c3c5
XTerm*foreground:   #c1c3c5
UXTerm*foreground:  #c1c3c5
URxvt*background:   [100]#0a1218
XTerm*background:   #0a1218
UXTerm*background:  #0a1218
URxvt*cursorColor:  #c1c3c5
XTerm*cursorColor:  #c1c3c5
UXTerm*cursorColor: #c1c3c5
URxvt*borderColor:  [100]#0a1218

! Colors 0-15.
*.color0: #0a1218
*color0:  #0a1218
*.color1: #2C6B49
*color1:  #2C6B49
*.color2: #4C6644
*color2:  #4C6644
*.color3: #108C58
*color3:  #108C58
*.color4: #199B5F
*color4:  #199B5F
*.color5: #0BAD66
*color5:  #0BAD66
*.color6: #51A55F
*color6:  #51A55F
*.color7: #c1c3c5
*color7:  #c1c3c5
*.color8: #59646d
*color8:  #59646d
*.color9: #2C6B49
*color9:  #2C6B49
*.color10: #4C6644
*color10:  #4C6644
*.color11: #108C58
*color11:  #108C58
*.color12: #199B5F
*color12:  #199B5F
*.color13: #0BAD66
*color13:  #0BAD66
*.color14: #51A55F
*color14:  #51A55F
*.color15: #c1c3c5
*color15:  #c1c3c5

! Black color that will not be affected by bold highlighting.
*.color66: #0a1218
*color66:  #0a1218

! Xclock colors.
XClock*foreground: #c1c3c5
XClock*background: #0a1218
XClock*majorColor:  rgba:c1/c3/c5/ff
XClock*minorColor:  rgba:c1/c3/c5/ff
XClock*hourColor:   rgba:c1/c3/c5/ff
XClock*minuteColor: rgba:c1/c3/c5/ff
XClock*secondColor: rgba:c1/c3/c5/ff

! Set depth to make transparency work.
URxvt*depth: 32
