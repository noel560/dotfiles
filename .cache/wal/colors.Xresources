! X colors.
! Generated by 'wal'
*foreground:        #c3c5c6
*background:        #121a1b
*.foreground:       #c3c5c6
*.background:       #121a1b
emacs*foreground:   #c3c5c6
emacs*background:   #121a1b
URxvt*foreground:   #c3c5c6
XTerm*foreground:   #c3c5c6
UXTerm*foreground:  #c3c5c6
URxvt*background:   [100]#121a1b
XTerm*background:   #121a1b
UXTerm*background:  #121a1b
URxvt*cursorColor:  #c3c5c6
XTerm*cursorColor:  #c3c5c6
UXTerm*cursorColor: #c3c5c6
URxvt*borderColor:  [100]#121a1b

! Colors 0-15.
*.color0: #121a1b
*color0:  #121a1b
*.color1: #3D6446
*color1:  #3D6446
*.color2: #4C4F4F
*color2:  #4C4F4F
*.color3: #616561
*color3:  #616561
*.color4: #8C6D67
*color4:  #8C6D67
*.color5: #708A67
*color5:  #708A67
*.color6: #878C78
*color6:  #878C78
*.color7: #c3c5c6
*color7:  #c3c5c6
*.color8: #5c7171
*color8:  #5c7171
*.color9: #3D6446
*color9:  #3D6446
*.color10: #4C4F4F
*color10:  #4C4F4F
*.color11: #616561
*color11:  #616561
*.color12: #8C6D67
*color12:  #8C6D67
*.color13: #708A67
*color13:  #708A67
*.color14: #878C78
*color14:  #878C78
*.color15: #c3c5c6
*color15:  #c3c5c6

! Black color that will not be affected by bold highlighting.
*.color66: #121a1b
*color66:  #121a1b

! Xclock colors.
XClock*foreground: #c3c5c6
XClock*background: #121a1b
XClock*majorColor:  rgba:c3/c5/c6/ff
XClock*minorColor:  rgba:c3/c5/c6/ff
XClock*hourColor:   rgba:c3/c5/c6/ff
XClock*minuteColor: rgba:c3/c5/c6/ff
XClock*secondColor: rgba:c3/c5/c6/ff

! Set depth to make transparency work.
URxvt*depth: 32
