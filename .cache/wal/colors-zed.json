{
    "$schema": "https://zed.dev/schema/themes/v0.1.0.json",
    "name": "pywal",
    "author": "pywal",
    "themes": [
        {
            "name": "pywal",
            "appearance": "dark",
            "style": {
                "background": "#121a1b90",
                "editor.background": "#121a1b90",
                "editor.foreground": "#c3c5c6",
                "text": "#c3c5c6",
                "text.muted": "#c3c5c670",
                "text.ignored": "#c3c5c640",
                "text.placeholder": "#c3c5c650",
                "ignored": "#c3c5c630",
                "element.hover": "#c3c5c630",
                "ghost_element.hover": "#3D644630",
                "ghost_element.selected": "#3D644630",
                "ghost_element.active": "#3D644660",
                "border": "#121a1b",
                "editor.highlighted_line.background": "#3D644610",
                "editor.active_line.background": "#3D644610",
                "panel.background": "#121a1b90",
                "title_bar.background": "#121a1b90",
                "title_bar.inactive_background": "#121a1b90",
                "status_bar.background": "#121a1b90",
                "drop_target.background": "#121a1b90",
                "elevated_surface.background": "#121a1b",
                "toolbar.background": "#121a1b90",
                "tab_bar.background": "#121a1b90",
                "tab.inactive_background": "#121a1b90",
                "tab.active_background": "#3D644630",
                "scrollbar.track.background": "transparent",
                "scrollbar.track.border": "#121a1b",
                "scrollbar.thumb.background": "#3D6446",
                "editor.gutter.background": "#121a1b90",
                "terminal.background": "#121a1b10",
                "terminal.foreground": "#c3c5c6",
                "terminal.dim_foreground": "#c3c5c6",
                "terminal.bright_foreground": "#c3c5c6",
                "terminal.ansi.black": "#121a1b",
                "terminal.ansi.red": "#3D6446",
                "terminal.ansi.green": "#4C4F4F",
                "terminal.ansi.yellow": "#616561",
                "terminal.ansi.blue": "#8C6D67",
                "terminal.ansi.magenta": "#708A67",
                "terminal.ansi.cyan": "#878C78",
                "terminal.ansi.white": "#c3c5c6",
                "terminal.ansi.bright_black": "#5c7171",
                "terminal.ansi.bright_red": "#3D6446",
                "terminal.ansi.bright_green": "#4C4F4F",
                "terminal.ansi.bright_yellow": "#616561",
                "terminal.ansi.bright_blue": "#8C6D67",
                "terminal.ansi.bright_magenta": "#708A67",
                "terminal.ansi.bright_cyan": "#878C78",
                "terminal.ansi.bright_white": "#c3c5c6",
                "modified": "#3D6446",
                "syntax": {
                    "attribute": {
                        "color": "#3D6446"
                    },
                    "boolean": {
                      "color": "#4C4F4F"
                    },
                    "comment": {
                      "color": "#5c7171"
                    },
                    "comment.doc": {
                      "color": "#5c7171"
                    },
                    "constant": {
                      "color": "#4C4F4F"
                    },
                    "function": {
                      "color": "#878C78"
                    },
                    "keyword": {
                      "color": "#8C6D67"
                    },
                    "number": {
                      "color": "#708A67"
                    },
                    "operator": {
                      "color": "#8C6D67"
                    },
                    "string": {
                      "color": "#3D6446"
                    },
                    "variable": {
                      "color": "#4C4F4F"
                    }
                },
                "players": [
                  {
                    "cursor": "#3D6446",
                    "background": "#121a1b",
                    "selection": "#3D644630"
                  }
                ]
            }
        }
    ]
}
